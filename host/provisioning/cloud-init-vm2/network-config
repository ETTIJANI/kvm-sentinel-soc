# cloud-init network-config v2 — vm-soc
#
# eth0 : WAN side, NAT network virbr0 (192.168.122.0/24), default route to the
#        hypervisor bridge 192.168.122.1. This is how Grafana and Ollama are
#        reached from the physical host and how the webhook leaves the guest.
# eth1 : isolated backend 10.10.0.0/24. promtail on vm-honeypot pushes to
#        10.10.0.20:3100 over this link. No gateway here on purpose: all
#        outbound traffic must use eth0.
version: 2
ethernets:
  wan:
    match:
      macaddress: "52:54:00:ac:12:20"
    set-name: eth0
    dhcp4: false
    addresses:
      - 192.168.122.20/24
    routes:
      - to: default
        via: 192.168.122.1
    nameservers:
      addresses:
        - 1.1.1.1
        - 9.9.9.9
  backend:
    match:
      macaddress: "52:54:00:10:10:02"
    set-name: eth1
    dhcp4: false
    addresses:
      - 10.10.0.20/24
    routes: []
    dhcp4-overrides:
      use-routes: false
