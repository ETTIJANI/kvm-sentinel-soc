    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed logins per minute, by source IP",
      "description": "The classic brute-force signature: one IP driving a sustained rate above 5 failures / 30 s.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 8
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (src_ip) (count_over_time({job=\"ssh-honeypot\"} |= \"Failed password\" | regexp \"from (?P<src_ip>[0-9\\.]+) port\" [1m]))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{src_ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
